# Copy to .env.local (or set in your host's dashboard) and fill in.

# Required for /admin: the password for whoever updates the amount raised.
ADMIN_PASSWORD=

# Optional: signs the login cookie. If unset, a key is derived from
# ADMIN_PASSWORD (changing the password then signs everyone out).
SESSION_SECRET=

# Storage for the live total. On a regular Node server (`npm start`) it is
# saved to this file by default; nothing else is needed.
# PROGRESS_FILE=data/progress.json

# On Vercel or other serverless hosts the filesystem is read-only, so use a
# free Upstash Redis database instead (Vercel's KV_REST_API_URL /
# KV_REST_API_TOKEN names work too):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
